{
  "name": "guanlan-research-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-web.mjs dev",
    "build": "node scripts/run-web.mjs build",
    "typecheck": "vue-tsc -b",
    "lint": "eslint src scripts tests --quiet",
    "format": "prettier --write scripts tests *.json *.ts *.js",
    "format:check": "prettier --check scripts tests *.json *.ts *.js",
    "test": "node --test tests/*.test.mjs",
    "test:browser:contracts": "node --test --test-timeout=120000 tests/e2e/branch-repair.mjs",
    "preview": "node scripts/preview-ui.mjs",
    "preview:ui": "node scripts/preview-ui.mjs",
    "snapshot:routes": "node scripts/generate-route-snapshot.mjs",
    "verify:ui": "node scripts/verify-ui.mjs",
    "verify:live": "node scripts/verify-live-data.mjs"
  },
  "dependencies": {
    "echarts": "6.1.0",
    "klinecharts": "10.1.0",
    "lucide-vue-next": "1.0.0",
    "vue": "3.5.44",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.72.0",
    "@vitejs/plugin-vue": "6.0.10",
    "eslint": "10.13.0",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.13.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vue-tsc": "3.3.12"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "overrides": {
    "postcss": "8.5.30",
    "esbuild": "0.25.12"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
