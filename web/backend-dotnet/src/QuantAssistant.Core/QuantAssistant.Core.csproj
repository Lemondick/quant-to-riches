<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>QuantAssistant.Core</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../../backend/src/quant_assistant/providers/exchange_calendars.json" LogicalName="QuantAssistant.ExchangeCalendars" />
    <EmbeddedResource Include="../../../backend/src/quant_assistant/providers/nav_freshness_policies.json" LogicalName="QuantAssistant.NavFreshnessPolicies" />
    <EmbeddedResource Include="../../../backend/src/quant_assistant/providers/index_registry.json" LogicalName="QuantAssistant.IndexRegistry" />
  </ItemGroup>
</Project>
