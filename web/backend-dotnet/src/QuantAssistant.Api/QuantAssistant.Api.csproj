<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>QuantAssistant.Api</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Npgsql.OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="QuantAssistant.Api.Tests" />
    <ProjectReference Include="..\QuantAssistant.Core\QuantAssistant.Core.csproj" />
    <ProjectReference Include="..\QuantAssistant.Infrastructure\QuantAssistant.Infrastructure.csproj" />
  </ItemGroup>

  <!--
    E13: build-time export of the versioned OpenAPI artifact to web/backend-dotnet/artifacts/openapi.json
    (contract section 5: D's API console reads this file first; C's CI validates web/docs/api.md against it).
    Trigger: dotnet build -p:ExportOpenApi=true; deploy/publish.sh triggers it on Release builds.
  -->
  <Target Name="ExportOpenApi" AfterTargets="Build" Condition="'$(ExportOpenApi)' == 'true'">
    <Exec Command="dotnet &quot;$(TargetPath)&quot; --export-openapi &quot;$(ProjectDir)../../artifacts/openapi.json&quot;" ConsoleToMsBuild="true" />
  </Target>

</Project>