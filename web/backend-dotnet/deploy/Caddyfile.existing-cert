# Replace this example domain; keep certificate material outside the release.
quant.example.com {
    log {
        output stdout
        format json
    }
    tls /etc/caddy/quant-tls/fullchain.pem /etc/caddy/quant-tls/privkey.pem
    encode zstd gzip
    @internal path /internal/* /openapi.json
    respond @internal 404
    reverse_proxy 127.0.0.1:8765

    # 安全响应头（与生产 Caddyfile 同步；HSTS 仅生产 Caddyfile 启用，本文件按契约不同步）。
    # CSP report-only 违规上报 POST /api/v1/csp-report 由流 A 后端实现。
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'self'; object-src 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; font-src 'self' data:; frame-ancestors 'none'; report-uri /api/v1/csp-report"
        -Server
    }
}
