# Copy to web/deploy/.env and set a real DNS name before starting Caddy.
QUANT_DOMAIN=quant.example.com
# Accounts are initialized interactively with scripts/manage_users.py.
# No shared API token or default account password is used.
# Empty uses https://QUANT_DOMAIN. Override with exact origins only; never '*'.
QUANT_CORS_ORIGINS=
QUANT_OCR_PROVIDER=paddleocr
PADDLE_OCR_ENDPOINT=https://paddleocr.xzrcka.me/ocr
